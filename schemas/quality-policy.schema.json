{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workbench.local/schemas/quality-policy.schema.json",
  "title": "quality-policy",
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "citation_resolution_rate",
              "verified_claim_coverage",
              "screening_decision_coverage",
              "fulltext_ratio",
              "schema_pass_rate",
              "analysis_reproducibility",
              "screening_precision",
              "screening_recall"
            ]
          },
          "min": {
            "type": "number"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "min",
          "severity",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "metrics"
  ],
  "additionalProperties": false
}
