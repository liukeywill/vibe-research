{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workbench.local/schemas/screening.schema.json",
  "title": "screening",
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "criteria": {
      "type": "object",
      "properties": {
        "include_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "exclude_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "year_min": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "year_max": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "require_abstract": {
          "type": "boolean"
        }
      },
      "required": [
        "include_terms",
        "exclude_terms",
        "year_min",
        "year_max",
        "require_abstract"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "include",
              "exclude",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source_id",
          "decision",
          "reason",
          "rule_ids",
          "reviewer",
          "reviewed_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dedup": {
      "type": "object",
      "properties": {
        "exact_duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kept_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "removed_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "kept_id",
              "removed_id",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "possible_duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 2
              },
              "similarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "source_ids",
              "similarity",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "exact_duplicates",
        "possible_duplicates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "criteria",
    "decisions",
    "dedup"
  ],
  "additionalProperties": false
}
