{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workbench.local/schemas/study-design.schema.json",
  "title": "study-design",
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "proposed",
              "tested",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "evidence_ids",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "design": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "name",
          "role",
          "type",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "analysis_plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sample_plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "question",
    "hypotheses",
    "method",
    "design",
    "variables",
    "analysis_plan",
    "sample_plan",
    "limitations"
  ],
  "additionalProperties": false
}
