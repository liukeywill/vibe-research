{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-workbench.local/schemas/quality-report.schema.json",
  "title": "quality-report",
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "numerator": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "denominator": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_measured",
              "not_applicable"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "name",
          "value",
          "numerator",
          "denominator",
          "threshold",
          "status",
          "severity",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "overall_status": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_config": {
      "type": "object",
      "properties": {
        "policy_path": {
          "anyOf": [
            {"$ref": "#/$defs/nonemptyString"},
            {"type": "null"}
          ]
        },
        "benchmark_path": {
          "anyOf": [
            {"$ref": "#/$defs/nonemptyString"},
            {"type": "null"}
          ]
        }
      },
      "required": ["policy_path", "benchmark_path"],
      "additionalProperties": false
    },
    "evaluation_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"},
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "evaluated_at",
    "metrics",
    "overall_status",
    "limitations"
  ],
  "additionalProperties": false
}
